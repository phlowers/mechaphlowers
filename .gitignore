# Folder to locally store python draft scripts or draft jupyter notebookx.
# They won't be committed and ruff won't analyze them nor complain about formatting or linting errors in them,
# for it ignores git-ignored files by default.
.draft/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
dist*/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Settings vscode
.vscode/

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
output_test

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3

# PyBuilder
target/

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# tools
.pdm-build/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
venv*/
.venv*/

# mypy
.mypy_cache/

# IDE - Eclipse
/.project

# IDE - VSCode
# .vscode/

# Docs
docs/source/coverage
docs/build

# csv files
datafiles

# config file
conf/default.json

# data
input_data

# LLM cache
.notes
.llm_cache

.github

